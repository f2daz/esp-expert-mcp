# Reproduzierbare Grundkonfiguration. Target-spezifisches in sdkconfig.defaults.<target>.
# Nach Änderungen: `idf.py fullclean` oder sdkconfig löschen, damit Defaults greifen.

# Flash / Partitionen – an Modul anpassen
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA-Rollback: neue Firmware muss sich per esp_ota_mark_app_valid_cancel_rollback() bestätigen
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Diagnose
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# Logging: Entwicklung INFO, für Release ggf. WARN
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Tick 1000 Hz, damit pdMS_TO_TICKS kleine Werte nicht auf 0 rundet
CONFIG_FREERTOS_HZ=1000
