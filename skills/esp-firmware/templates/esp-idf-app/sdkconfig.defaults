# Reproducible base configuration. Target-specific settings go in sdkconfig.defaults.<target>.
# After changes: run `idf.py fullclean` or delete sdkconfig so the defaults take effect.

# Flash / partitions – adjust to your module
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA rollback: new firmware must confirm itself via esp_ota_mark_app_valid_cancel_rollback()
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Diagnostics
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# Logging: INFO for development, consider WARN for release
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 1000 Hz tick so pdMS_TO_TICKS does not round small values to 0
CONFIG_FREERTOS_HZ=1000
